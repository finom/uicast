{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "uicast": ["./packages/core/src/index.ts"],
      "uicast/prompt": ["./packages/core/src/prompt/index.ts"],
      "@uicast/react": ["./packages/react/src/index.ts"],
      "@uicast/react/*": ["./packages/react/src/*"],
      "@uicast/streamdown": ["./packages/streamdown/src/index.ts"],
      "@uicast/streamdown/prompt": ["./packages/streamdown/src/prompt/index.ts"]
    },
    "experimentalDecorators": true
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/core/**/*.tsx",
    "packages/core/**/*.mts",
    "packages/react/**/*.ts",
    "packages/react/**/*.tsx",
    "packages/react/**/*.mts",
    "packages/shadcn-catalog/**/*.ts",
    "packages/shadcn-catalog/**/*.tsx",
    "packages/shadcn-catalog/**/*.mts",
    "packages/streamdown/**/*.ts",
    "packages/streamdown/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/node_modules", "dist"]
}

{
  "name": "@uicast/react",
  "version": "0.0.1-beta.2",
  "description": "the React binding for uicast",
  "license": "MIT",
  "author": "Andrey Gubanov (https://github.com/finom)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "@uicast/core": "0.0.1-beta.2"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.1",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "standard-tool": "^0.1.0",
    "vitest": "^5.0.1",
    "zod": "~4.6.5"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "generative-ui",
    "llm",
    "react",
    "renderer",
    "streaming",
    "ui",
    "agent"
  ]
}

{
  "name": "@uicast/react",
  "version": "0.0.0",
  "description": "the React binding for uicast",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/react"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/test/**",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "uicast": "0.0.0",
    "standard-tool": "^0.0.6",
    "zod": "~4.3.6"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vitest": "^4.1.0"
  }
}

{
  "name": "@uicast/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "update-mdx-snippets": "node scripts/update-mdx-snippets.mjs",
    "predev": "npm run update-mdx-snippets",
    "dev": "next dev",
    "prebuild": "npm run update-mdx-snippets",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind && cp -R public/_pagefind out/_pagefind",
    "start": "next start",
    "typecheck": "tsc --noEmit"

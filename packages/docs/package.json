    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-loading-skeleton": "^3.5.0",
    "react-resizable-panels": "^4.10.0",
    "standard-tool": "^0.1.0",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pagefind": "^1.5.2",

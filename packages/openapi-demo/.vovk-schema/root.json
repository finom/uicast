{
  "$schema": "https://vovk.dev/api/schema/v3/segment.json",
  "emitSchema": true,
  "segmentName": "",
  "segmentType": "segment",
  "controllers": {
    "ConnectionController": {
      "rpcModuleName": "ConnectionController",
      "originalControllerName": "ConnectionController",
      "prefix": "connections",
      "handlers": {
        "getConnections": {
          "validation": {
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "name": {
                    "type": "string",
                    "description": "Short identifier, and the prefix of every derived tool name."
                  },
                  "openapiUrl": {
                    "type": "string",
                    "description": "URL of the API's OpenAPI document."
                  },
                  "authType": {
                    "type": "string",
                    "enum": [
                      "none",
                      "header",
                      "query"
                    ]
                  },
                  "authName": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Header or query parameter carrying the credential."
                  },
                  "configured": {
                    "type": "boolean",
                    "description": "Whether a credential is stored. The credential itself is never returned."
                  },
                  "createdAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "openapiUrl",
                  "authType",
                  "authName",
                  "configured",
                  "createdAt"
                ]
              }
            }
          },
          "operationObject": {
            "summary": "List connected APIs"
          },
          "path": "",
          "httpMethod": "GET"
        },
        "getConnection": {
          "validation": {
            "params": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            },
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "description": "Short identifier, and the prefix of every derived tool name."
                },
                "openapiUrl": {
                  "type": "string",
                  "description": "URL of the API's OpenAPI document."
                },
                "authType": {
                  "type": "string",
                  "enum": [
                    "none",
                    "header",
                    "query"
                  ]
                },
                "authName": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Header or query parameter carrying the credential."
                },
                "configured": {
                  "type": "boolean",
                  "description": "Whether a credential is stored. The credential itself is never returned."
                },
                "createdAt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "openapiUrl",
                "authType",
                "authName",
                "configured",
                "createdAt"
              ]
            }
          },
          "operationObject": {
            "summary": "Get one connected API"
          },
          "path": "{id}",
          "httpMethod": "GET"
        },
        "createConnection": {
          "validation": {
            "body": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "description": "Short identifier for the API, e.g. `stripe`."
                },
                "openapiUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL of the API's OpenAPI document."
                },
                "authType": {
                  "type": "string",
                  "enum": [
                    "none",
                    "header",
                    "query"
                  ],
                  "description": "How the credential travels with each request."
                },
                "authName": {
                  "description": "Header or query parameter name, e.g. `Authorization`.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "authPrefix": {
                  "description": "Prepended to the credential, e.g. `Bearer `.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "credential": {
                  "description": "The API key or token itself.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "openapiUrl",
                "authType"
              ]
            },
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "description": "Short identifier, and the prefix of every derived tool name."
                },
                "openapiUrl": {
                  "type": "string",
                  "description": "URL of the API's OpenAPI document."
                },
                "authType": {
                  "type": "string",
                  "enum": [
                    "none",
                    "header",
                    "query"
                  ]
                },
                "authName": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Header or query parameter carrying the credential."
                },
                "configured": {
                  "type": "boolean",
                  "description": "Whether a credential is stored. The credential itself is never returned."
                },
                "createdAt": {
                  "type": "string"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The operations this API now exposes. They become callable functions on the next turn, not this one."
                }
              },
              "required": [
                "id",
                "name",
                "openapiUrl",
                "authType",
                "authName",
                "configured",
                "createdAt",
                "operations"
              ]
            }
          },
          "operationObject": {
            "summary": "Connect an API",
            "description": "Stores the OpenAPI document URL and how the API authenticates. Called from the connection form the model generates, so its shape is what the model is taught to fill in."
          },
          "path": "",
          "httpMethod": "POST"
        },
        "deleteConnection": {
          "validation": {
            "params": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            },
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id"
              ]
            }
          },
          "operationObject": {
            "summary": "Disconnect an API"
          },
          "path": "{id}",
          "httpMethod": "DELETE"
        }
      }
    },
    "ToolController": {
      "rpcModuleName": "ToolController",
      "originalControllerName": "ToolController",
      "prefix": "tools",
      "handlers": {
        "getTools": {
          "validation": {
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "tools": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "The identifier a uicast expression calls."
                      },
                      "description": {
                        "type": "string"
                      },
                      "inputSchema": {
                        "anyOf": [
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "outputSchema": {
                        "anyOf": [
                          {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Null when the API declares no response shape for the operation."
                      }
                    },
                    "required": [
                      "name",
                      "description",
                      "inputSchema",
                      "outputSchema"
                    ]
                  }
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "connectionId": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "name": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "connectionId",
                      "name",
                      "error"
                    ]
                  }
                }
              },
              "required": [
                "tools",
                "failures"
              ]
            }
          },
          "operationObject": {
            "summary": "List callable operations",
            "description": "Every operation of every connected API, derived from its OpenAPI document."
          },
          "path": "",
          "httpMethod": "GET"
        },
        "callTool": {
          "validation": {
            "body": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Tool name, e.g. `stripe_listCharges`."
                },
                "input": {
                  "type": "object",
                  "properties": {
                    "body": {},
                    "query": {},
                    "params": {}
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "result": {}
              },
              "required": [
                "result"
              ]
            }
          },
          "operationObject": {
            "summary": "Call an operation",
            "description": "Runs one derived operation server-side, so the connection's credential never reaches the browser."
          },
          "path": "call",
          "httpMethod": "POST"
        }
      }
    },
    "ChatController": {
      "rpcModuleName": "ChatController",
      "originalControllerName": "ChatController",
      "prefix": "chat",
      "handlers": {
        "getChats": {
          "validation": {
            "output": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "createdAt"
                ]
              }
            }
          },
          "operationObject": {
            "summary": "List chats"
          },
          "path": "",
          "httpMethod": "GET"
        },
        "sendMessage": {
          "path": "messages",
          "httpMethod": "POST",
          "operationObject": {
            "summary": "Send a message",
            "description": "Streams the assistant's reply as an AI SDK UI message stream. The reply may contain `uicast` fences, whose functions are the operations of every connected API."
          }
        }
      }
    },
    "GenerationController": {
      "rpcModuleName": "GenerationController",
      "originalControllerName": "GenerationController",
      "prefix": "generation",
      "handlers": {
        "generate": {
          "path": "generate",
          "httpMethod": "POST",
          "operationObject": {
            "summary": "Generate a page",
            "description": "Streams JSONLines: one line per element as the model emits it, then a `done` control line. A page that already has entries is edited rather than regenerated."
          }
        }
      }
    }
  }
}
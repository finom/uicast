{
  "name": "@uicast/expr",
  "version": "0.0.1-beta.0",
  "description": "A JavaScript-shaped expression language that JavaScript does not run: closed AST allow-list, runtime membrane, CPU budget. No new Function, no unsafe-eval.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/expr"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "expression",
    "interpreter",
    "sandbox",
    "csp",
    "safe-eval",
    "ast",
    "llm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "standard-tool": "^0.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "uicast",
  "version": "0.0.1-beta.0",
  "description": "LLM-generated UIs from a stream of JSONLines — the framework-agnostic uicast engine: entry format, sandboxed expressions, reactive scopes, and prompt builders.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/uicast"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "generative-ui",
    "llm",
    "jsonlines",
    "streaming",
    "ui",
    "agent",
    "component-catalog"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/prompt/index.ts"
  },
  "files": [
    "src",
    "!src/**/test/**",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "acorn": "^8.16.0",
    "standard-tool": "^0.0.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "vitest": "^4.1.0",
    "zod": "~4.3.6"
  }
}

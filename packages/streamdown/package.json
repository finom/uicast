{
  "name": "@uicast/streamdown",
  "version": "0.0.5",
  "description": "the uicast Streamdown plugin",
  "license": "MIT",
  "author": "Andrey Gubanov (https://github.com/finom)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/streamdown"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "node -e \"if (!process.env.CI) throw new Error('Publish from CI: PACKAGE=<dir> npm run patch or minor tags a release, and the tag publishes it')\" && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uicast/core": "^0.0.5",
    "@uicast/react": "^0.0.5"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.2",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "streamdown": "^2.7.0",
    "vitest": "^5.0.3",
    "zod": "~4.6.5"
  },
  "homepage": "https://uicast.dev",
  "keywords": [
    "generative-ui",
    "llm",
    "streamdown",
    "markdown",
    "chat",
    "streaming",
    "ui"
  ]
}

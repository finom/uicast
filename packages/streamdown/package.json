{
  "name": "@uicast/streamdown",
  "version": "0.0.1-beta.1",
  "description": "the uicast Streamdown plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/streamdown"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/prompt/index.ts"
  },
  "files": [
    "src",
    "!src/**/test/**",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "@uicast/core": "0.0.1-beta.1",
    "@uicast/react": "0.0.1-beta.1"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "react": "^19.2.5",
    "streamdown": "^2.5.0",
    "vitest": "^4.1.0"
  }
}

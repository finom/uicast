{
  "name": "@uicast/streamdown",
  "version": "0.0.1-beta.3",
  "description": "the uicast Streamdown plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/streamdown"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "default": "./dist/prompt/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG"
  },
  "dependencies": {
    "@uicast/core": "0.0.1-beta.2",
    "@uicast/react": "0.0.1-beta.2"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "happy-dom": "^20.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "streamdown": "^2.5.0",
    "vitest": "^4.1.0",
    "zod": "~4.5.4"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "generative-ui",
    "llm",
    "streamdown",
    "markdown",
    "chat",
    "streaming",
    "ui"
  ]
}

{
  "name": "@uicast/shadcn-catalog",
  "version": "0.0.1-beta.2",
  "description": "the uicast component catalog over shadcn/Radix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/shadcn-catalog"
  },
  "type": "module",
  "exports": {
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./all-defs": {
      "types": "./dist/all-defs.d.ts",
      "default": "./dist/all-defs.js"
    },
    "./all-impls": {
      "types": "./dist/all-impls.d.ts",
      "default": "./dist/all-impls.js"
    },
    "./document-skeleton": {
      "types": "./dist/document-skeleton/index.d.ts",
      "default": "./dist/document-skeleton/index.js"
    },
    "./fallback-components": {
      "types": "./dist/fallback-components/index.d.ts",
      "default": "./dist/fallback-components/index.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./catalog.css": "./dist/catalog.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:css",
    "prepublishOnly": "npm run build",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG",
    "build:css": "tailwindcss -i styles/entry.css -o dist/catalog.css --minify && tailwindcss -i styles/theme-entry.css -o dist/theme.css --minify",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uicast/core": "0.0.1-beta.2",
    "@uicast/react": "0.0.1-beta.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.41.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.1",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "zod": "~4.5.4"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.0.0"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "generative-ui",
    "llm",
    "shadcn",
    "radix",
    "component-catalog",
    "ui",
    "react"
  ]
}

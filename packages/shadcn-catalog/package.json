{
  "name": "@uicast/shadcn-catalog",
  "version": "0.0.1-beta.2",
  "description": "the uicast component catalog over shadcn/Radix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finom/uicast.git",
    "directory": "packages/shadcn-catalog"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./all/defs": {
      "types": "./dist/all/defs.d.ts",
      "default": "./dist/all/defs.js"
    },
    "./all/impls": {
      "types": "./dist/all/impls.d.ts",
      "default": "./dist/all/impls.js"
    },
    "./layout/defs": {
      "types": "./dist/layout/defs.d.ts",
      "default": "./dist/layout/defs.js"
    },
    "./layout/impls": {
      "types": "./dist/layout/impls.d.ts",
      "default": "./dist/layout/impls.js"
    },
    "./content/defs": {
      "types": "./dist/content/defs.d.ts",
      "default": "./dist/content/defs.js"
    },
    "./content/impls": {
      "types": "./dist/content/impls.d.ts",
      "default": "./dist/content/impls.js"
    },
    "./data/defs": {
      "types": "./dist/data/defs.d.ts",
      "default": "./dist/data/defs.js"
    },
    "./data/impls": {
      "types": "./dist/data/impls.d.ts",
      "default": "./dist/data/impls.js"
    },
    "./charts/defs": {
      "types": "./dist/charts/defs.d.ts",
      "default": "./dist/charts/defs.js"
    },
    "./charts/impls": {
      "types": "./dist/charts/impls.d.ts",
      "default": "./dist/charts/impls.js"
    },
    "./forms/defs": {
      "types": "./dist/forms/defs.d.ts",
      "default": "./dist/forms/defs.js"
    },
    "./forms/impls": {
      "types": "./dist/forms/impls.d.ts",
      "default": "./dist/forms/impls.js"
    },
    "./navigation/defs": {
      "types": "./dist/navigation/defs.d.ts",
      "default": "./dist/navigation/defs.js"
    },
    "./navigation/impls": {
      "types": "./dist/navigation/impls.d.ts",
      "default": "./dist/navigation/impls.js"
    },
    "./overlays/defs": {
      "types": "./dist/overlays/defs.d.ts",
      "default": "./dist/overlays/defs.js"
    },
    "./overlays/impls": {
      "types": "./dist/overlays/impls.d.ts",
      "default": "./dist/overlays/impls.js"
    },
    "./essential/defs": {
      "types": "./dist/essential/defs.d.ts",
      "default": "./dist/essential/defs.js"
    },
    "./essential/impls": {
      "types": "./dist/essential/impls.d.ts",
      "default": "./dist/essential/impls.js"
    },
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./catalog.css": "./dist/catalog.css",
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:css",
    "prepublishOnly": "npm run build",
    "npm-publish": "if [ -z \"$NPM_TAG\" ]; then echo 'Error: NPM_TAG is not set'; exit 1; fi; npm publish --tag=$NPM_TAG",
    "build:css": "tailwindcss -i styles/entry.css -o dist/catalog.css --minify && tailwindcss -i styles/theme-entry.css -o dist/theme.css --minify",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uicast/core": "0.0.1-beta.2",
    "@uicast/react": "0.0.1-beta.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.8.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "~4.6.5"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.15",
    "tw-animate-css": "^1.4.0",
    "vitest": "^5.0.1"
  },
  "homepage": "https://github.com/finom/uicast#readme",
  "keywords": [
    "generative-ui",
    "llm",
    "shadcn",
    "radix",
    "component-catalog",
    "ui",
    "react"
  ]
}

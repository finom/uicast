# Local docker-compose default; point at a Neon pooled connection string in production.
DATABASE_URL=postgres://uicast:uicast@localhost:5432/uicast
# Encrypts stored OpenRouter keys (AES-256-GCM). Generate: openssl rand -base64 32
APP_SECRET=
# Model used for all generation, resolved through each user's OpenRouter key.
OPENROUTER_MODEL=anthropic/claude-opus-5.5

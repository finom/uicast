{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@uicast/expr": ["../expr/src/index.ts"],
      "@uicast/expr/internal": ["../expr/src/internal.ts"],
      "@uicast/expr-passthrough": ["../expr-passthrough/src/index.ts"],
      "@uicast/core": ["../core/src/index.ts"],
      "@uicast/core/internal": ["../core/src/internal.ts"],
      "@uicast/core/prompt": ["../core/src/prompt/index.ts"],
      "@uicast/react": ["../react/src/index.ts"],
      "@uicast/shadcn-catalog/events": ["../shadcn-catalog/src/events/index.ts"],
      "@uicast/shadcn-catalog/all-defs": ["../shadcn-catalog/src/all-defs.ts"],
      "@uicast/shadcn-catalog/all-impls": ["../shadcn-catalog/src/all-impls.ts"],
      "@uicast/shadcn-catalog/document-skeleton": ["../shadcn-catalog/src/document-skeleton/index.tsx"],
      "@uicast/shadcn-catalog/fallback-components": ["../shadcn-catalog/src/fallback-components/index.ts"],
      "@uicast/shadcn-catalog/ui/*": ["../shadcn-catalog/src/components/ui/*"],
      "@uicast/streamdown": ["../streamdown/src/index.ts"],
      "@uicast/streamdown/prompt": ["../streamdown/src/prompt/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}

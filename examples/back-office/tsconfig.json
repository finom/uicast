{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@uicast/expr": ["../../packages/expr/src/index.ts"],
      "@uicast/expr/internal": ["../../packages/expr/src/internal.ts"],
      "@uicast/core": ["../../packages/core/src/index.ts"],
      "@uicast/core/internal": ["../../packages/core/src/internal.ts"],
      "@uicast/core/prompt": ["../../packages/core/src/prompt/index.ts"],
      "@uicast/react": ["../../packages/react/src/index.ts"],
      "@uicast/shadcn-catalog": ["../../packages/shadcn-catalog/src/index.ts"],
      "@uicast/shadcn-catalog/all/defs": ["../../packages/shadcn-catalog/src/all/defs.ts"],
      "@uicast/shadcn-catalog/all/impls": ["../../packages/shadcn-catalog/src/all/impls.ts"],
      "@uicast/shadcn-catalog/ui/*": ["../../packages/shadcn-catalog/src/components/ui/*"],
      "@uicast/streamdown": ["../../packages/streamdown/src/index.ts"],
      "@uicast/streamdown/prompt": ["../../packages/streamdown/src/prompt/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
